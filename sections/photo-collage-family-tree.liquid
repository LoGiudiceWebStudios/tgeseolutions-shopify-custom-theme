{% comment %}
  Displays a photo collage in a vertical timeline style, similar to the provided image.
{% endcomment %}
<style>
  .family-tree-timeline {
    position: relative;
    margin: 6rem auto;
    max-width: 1100px;
    padding-left: 60px;
    padding-right: 60px;
  }
  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0;
    width: 6px;
    height: 100%;
    background: #f9b233;
    transform: translateX(-50%);
    z-index: 0;
  }
  .timeline-block {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6rem;
    z-index: 1;
  }
  .timeline-block.even {
    flex-direction: row-reverse;
  }
  .timeline-img {
    width: 340px;
    min-width: 220px;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    margin: 0 3rem;
    background: #fff;
    border: 5px solid #eee;
    object-fit: cover;
  }
  .timeline-content {
    background: #fff;
    border-radius: 2rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
    padding: 2.5rem 3rem;
    min-width: 340px;
    max-width: 540px;
    font-family: var(--main-font, Arial, sans-serif);
    position: relative;
  }
  .timeline-date {
    font-weight: bold;
    font-size: 2.2rem;
    color: #f9b233;
    margin-bottom: 1rem;
    font-family: var(--main-font, Arial, sans-serif);
  }
  .timeline-title {
    font-weight: bold;
    font-size: 1.8rem;
    margin-bottom: 1rem;
    font-family: var(--main-font, Arial, sans-serif);
  }
  .timeline-desc {
    font-size: 1.3rem;
    color: #555;
    margin-bottom: 1rem;
    font-family: var(--main-font, Arial, sans-serif);
  }
  @media (max-width: 900px) {
    .family-tree-timeline {
      max-width: 98vw;
      padding-left: 10px;
      padding-right: 10px;
    }
    .timeline-block,
    .timeline-block.even {
      flex-direction: column;
      align-items: center;
    }
    .timeline-img {
      margin: 0 0 2rem 0;
      width: 95vw;
      max-width: 420px;
    }
    .timeline-content {
      min-width: 0;
      max-width: 98vw;
      padding: 1.5rem;
    }
    .timeline-date {
      font-size: 1.5rem;
    }
    .timeline-title {
      font-size: 1.2rem;
    }
    .timeline-desc {
      font-size: 1rem;
    }
  }
</style>

<div class="family-tree-timeline">
  <div class="timeline-line"></div>
  {% for block in section.blocks %}
    {% assign even = forloop.index0 | modulo: 2 %}
    <div class="timeline-block{% if even == 1 %} even{% endif %}">
      {% if block.settings.image != blank %}
        <img
          class="timeline-img"
          src="{{ block.settings.image | image_url: width: 700 }}"
          alt="{{ block.settings.name | escape }}"
          width="700"
          height="500"
        >
      {% endif %}
      <div class="timeline-content">
        {% if block.settings.date != blank %}
          <div class="timeline-date">{{ block.settings.date }}</div>
        {% endif %}
        {% if block.settings.name != blank %}
          <div class="timeline-title">{{ block.settings.name }}</div>
        {% endif %}
        {% if block.settings.desc != blank %}
          <div class="timeline-desc">{{ block.settings.desc }}</div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Photo Collage Timeline",
  "settings": [],
  "blocks": [
    {
      "type": "node",
      "name": "Timeline Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date/Year"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo Collage Timeline",
      "blocks": []
    }
  ]
}
{% endschema %}
